---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Signature from '../components/Signature.astro';
import Story from '../components/Story.astro';
import KnownFor from '../components/KnownFor.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#f7f0e3" />

    <title>The Big Bro — Coffeehouse · Bakery · Pâtisserie · Gourmet Eatery · Panchkula</title>
    <meta
      name="description"
      content="The Big Bro, Panchkula — a family bakery-café that views baking as an art. Bespoke celebration cakes, shakes, mocha, continental dishes and fresh-baked pizza. Rated 4.2★ on Google."
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="The Big Bro — The New Religion of Bakery" />
    <meta
      property="og:description"
      content="Bespoke celebration cakes, fresh-baked pizza and a coffee bar worth the visit. SCO-352, Sector 9, Panchkula."
    />
    <meta property="og:locale" content="en_IN" />
  </head>
  <body>
    <Nav />
    <main id="main">
      <Hero />
      <TrustStrip />
      <Signature />
      <Story />
      <KnownFor />
      <Visit />
    </main>
    <Footer />
  </body>
</html>
