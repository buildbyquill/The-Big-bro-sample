---
import Mascot from './Mascot.astro';

const links = [
  { href: '#signature', label: 'Signature' },
  { href: '#story', label: 'Our Story' },
  { href: '#known-for', label: 'Known For' },
  { href: '#visit', label: 'Visit Us' },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Mascot class="footer__mark" showWordmark={false} />
      <div>
        <p class="footer__word">THE BIG BRO</p>
        <p class="footer__sub">Coffeehouse · Bakery · Pâtisserie · Gourmet Eatery</p>
      </div>
    </div>

    <nav class="footer__links" aria-label="Footer">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <a class="footer__insta" href="https://instagram.com/thebigbropanchkula" rel="noopener" target="_blank">
      Instagram · @thebigbropanchkula
    </a>
  </div>

  <p class="footer__note container">
    Showcase concept page · imagery and maps are placeholders pending client assets.
    Facts sourced from public reviews, press coverage and the brand’s own Instagram.
  </p>
</footer>

<style>
  .footer {
    background: var(--charcoal);
    color: var(--cream);
    padding-block: 3rem 1.6rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .footer__mark {
    width: 3rem;
    height: 3rem;
  }

  .footer__word {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--cream-light);
  }

  .footer__sub {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(247, 240, 227, 0.6);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
  }

  .footer__links a,
  .footer__insta {
    font-size: 0.92rem;
    color: rgba(247, 240, 227, 0.78);
    transition: color 0.15s ease;
  }

  .footer__links a:hover,
  .footer__insta:hover {
    color: var(--gold);
  }

  .footer__note {
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(247, 240, 227, 0.15);
    font-size: 0.78rem;
    color: rgba(247, 240, 227, 0.5);
  }

  @media (max-width: 700px) {
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
