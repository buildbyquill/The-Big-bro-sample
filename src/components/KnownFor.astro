---
const items = [
  {
    name: 'Cakes',
    line: 'Custom & celebration cakes, made to order',
    icon: 'cake',
  },
  {
    name: 'Shakes',
    line: 'Thick, cold and consistently praised',
    icon: 'shake',
  },
  {
    name: 'Mocha & Red Velvet',
    line: 'The two crowd favourites of our menu',
    icon: 'cup',
  },
  {
    name: 'Continental',
    line: 'The gourmet side of the kitchen',
    icon: 'plate',
  },
  {
    name: 'Fresh-Baked Pizza',
    line: 'Bases baked fresh, not bought in',
    icon: 'pizza',
  },
];
---

<section class="section knownfor" id="known-for">
  <div class="container">
    <header class="knownfor__head">
      <p class="section-label">What We’re Known For</p>
      <h2 class="section-title">Praise your neighbours wrote for us.</h2>
      <p class="section-sub">
        Pulled straight from independent reviews — the dishes and drinks Panchkula
        keeps coming back for.
      </p>
    </header>

    <ul class="knownfor__grid">
      {
        items.map((item) => (
          <li class="knownfor__card">
            <span class="knownfor__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                {item.icon === 'cake' && (
                  <>
                    <path d="M4 20h16" />
                    <path d="M4 20v-5l8-3 8 3v5" />
                    <path d="M12 12v-4" />
                    <path d="M6 8h12l-2-3h-8z" />
                    <path d="M8.5 20v-3 M12 20v-3 M15.5 20v-3" stroke-dasharray="1 2" />
                  </>
                )}
                {item.icon === 'shake' && (
                  <>
                    <path d="M7 8l2.4 12h5.2L17 8z" />
                    <path d="M7.5 12h9" />
                    <path d="M10 3l-1 4 M14 3l1 4" />
                    <path d="M10 5h4" />
                    <path d="M13.5 6.5l4.5 1.5" />
                  </>
                )}
                {item.icon === 'cup' && (
                  <>
                    <path d="M5 8h10v6a5 5 0 0 1-5 5h0a5 5 0 0 1-5-5z" />
                    <path d="M15 9h2a2.5 2.5 0 0 1 0 5h-2" />
                    <path d="M9 4v1 M12 4v1 M9 4 h3" />
                    <path d="M4 20h12" />
                  </>
                )}
                {item.icon === 'plate' && (
                  <>
                    <circle cx="10" cy="12" r="7" />
                    <circle cx="10" cy="12" r="2.2" />
                    <path d="M16 9l4-4 M18 11l3-3" />
                    <path d="M19 5h2v2" />
                  </>
                )}
                {item.icon === 'pizza' && (
                  <>
                    <path d="M20 6.5C18 4 15 3 11.5 3 8 3 5 4 3 6.5l8.5 14.5z" />
                    <path d="M12 12h.01 M9 9.5h.01 M15 10h.01" />
                    <path d="M3 6.5h17" stroke-dasharray="1.5 2" opacity="0.5" />
                  </>
                )}
              </svg>
            </span>
            <h3 class="knownfor__name">{item.name}</h3>
            <p class="knownfor__line">{item.line}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .knownfor__head {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .knownfor__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
    gap: clamp(1rem, 2.5vw, 1.6rem);
  }

  .knownfor__card {
    background: var(--cream-light);
    border: 1px solid var(--cream-deep);
    border-radius: var(--radius-md);
    padding: 1.6rem 1.4rem;
    text-align: center;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .knownfor__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--gold);
  }

  .knownfor__icon {
    display: inline-grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: var(--maroon);
    color: var(--cream-light);
  }

  .knownfor__icon svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .knownfor__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    margin-top: 1rem;
    color: var(--charcoal);
  }

  .knownfor__line {
    margin-top: 0.4rem;
    font-size: 0.88rem;
    color: var(--charcoal-soft);
  }
</style>
