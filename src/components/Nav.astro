---
import Mascot from './Mascot.astro';

const links = [
  { href: '#signature', label: 'Signature' },
  { href: '#story', label: 'Our Story' },
  { href: '#known-for', label: 'Known For' },
  { href: '#visit', label: 'Visit Us' },
];
---

<a class="skip-link" href="#main">Skip to content</a>

<header class="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href="#top" aria-label="The Big Bro — back to top">
      <Mascot class="nav__mark" showWordmark={false} />
      <span class="nav__word">THE BIG BRO</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <a class="btn btn--primary nav__cta" href="tel:+919779665544">Order Now</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 240, 227, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--cream-deep);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.7rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav__mark {
    width: 2.6rem;
    height: 2.6rem;
    flex-shrink: 0;
  }

  .nav__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.22em;
    color: var(--maroon);
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.2rem);
    margin-left: auto;
  }

  .nav__links a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--charcoal-soft);
    transition: color 0.15s ease;
  }

  .nav__links a:hover {
    color: var(--maroon);
  }

  .nav__cta {
    padding: 0.7rem 1.35rem;
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .nav__links {
      display: none;
    }
  }
</style>
