---
import Mascot from './Mascot.astro';
---

<section class="hero" id="top">
  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="section-label">Coffeehouse · Bakery · Pâtisserie · Gourmet Eatery</p>
      <h1 class="hero__title">
        The New Religion<br />
        <em>of Bakery</em>
      </h1>
      <p class="hero__lede">
        “The Big Bro is an idea of viewing Bakery as an Art and not as a business.”
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="tel:+919779665544">Order Now</a>
        <a class="btn btn--ghost" href="#signature">View Menu</a>
      </div>
    </div>

    <div class="hero__visual">
      <Mascot class="hero__mascot" />
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(90% 70% at 82% 18%, var(--cream-light) 0%, transparent 60%),
      var(--cream);
    overflow: hidden;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(2.7rem, 7vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: var(--charcoal);
    margin-top: 1.1rem;
  }

  .hero__title em {
    font-style: italic;
    font-weight: 550;
    color: var(--maroon);
  }

  .hero__lede {
    margin-top: 1.4rem;
    max-width: 34ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--charcoal-soft);
    border-left: 3px solid var(--gold);
    padding-left: 1rem;
  }

  .hero__cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .hero__visual {
    display: grid;
    place-items: center;
  }

  .hero__mascot {
    width: min(100%, 26rem);
    filter: drop-shadow(0 18px 40px rgba(43, 39, 36, 0.16));
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero__lede {
      margin-inline: auto;
    }

    .hero__cta {
      justify-content: center;
    }

    .hero__visual {
      order: -1;
    }

    .hero__mascot {
      width: min(100%, 19rem);
    }
  }
</style>
